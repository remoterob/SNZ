# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Password (change this!)
VITE_ADMIN_PASSWORD=admin123

# Optional: a second password that only unlocks Fish Bingo admin
# (/bingo/admin/*), not the rest of /admin/*. Leave unset to disable it —
# VITE_ADMIN_PASSWORD keeps working everywhere, including Fish Bingo.
VITE_BINGO_ADMIN_PASSWORD=

# Optional: a second password that only unlocks Nationals admin
# (/nationals/admin), not the rest of /admin/*. Leave unset to disable it —
# VITE_ADMIN_PASSWORD keeps working everywhere, including Nationals.
VITE_NATIONALS_ADMIN_PASSWORD=

# Optional: a second password that only unlocks the Rosemergy Catfish Cull's
# competition admin (/competitions/:id/admin for that comp), not any other
# competition and not the rest of /admin/*. Leave unset to disable it.
VITE_CATFISH_ADMIN_PASSWORD=

# Resend API Key — used by every app-level email (invite-member.js,
# lib/backup.js, send-results-email.js). The sending domain used in the
# "from" address (snzmail.teamaotea.com) must be verified in this Resend
# account, or sends will fail/bounce. (spearfishingnz.co.nz itself can't be
# used — its DNS is on Wix, which doesn't support the subdomain MX record
# Resend requires.)
VITE_RESEND_API_KEY=re_your_api_key_here

# Auth emails (password reset, magic links, signup confirmation) are sent by
# SUPABASE, not by these functions — they don't read this file. Point
# Supabase at Resend's SMTP relay instead of its default (heavily throttled)
# mailer:
#   Supabase Dashboard → Project Settings → Authentication → SMTP Settings
#     Host: smtp.resend.com   Port: 465   Username: resend
#     Password: your Resend API key (re_...)
#     Sender email: an address on the verified domain, e.g. noreply@snzmail.teamaotea.com

# Optional: Logo URLs (if hosting separately)
# VITE_SNZ_LOGO_URL=https://your-cdn.com/snz-logo.avif
# VITE_SPONSOR_LOGO_URL=https://your-cdn.com/hunting-fishing-logo.png

# World Freshwater Spearfishing Championships 2026 (separate Supabase project)
VITE_WFSC_SUPABASE_URL=https://your-wfsc-project.supabase.co
VITE_WFSC_SUPABASE_ANON_KEY=your-wfsc-anon-key-here
VITE_WFSC_ADMIN_PASSWORD=wfsc2026

# ── Mailchimp member sync (server-side only — never VITE_ prefixed) ──────────
# Used by netlify/functions/mailchimp-sync.js, which a Postgres trigger on
# public.members calls whenever a member is created or changed (migration 023).
# The datacenter is the suffix on the API key (e.g. ...-us14).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Shared secret guarding the endpoint. Must match the 'mailchimp_sync_secret'
# value stored in Supabase Vault — see migration 023 for the setup snippet.
MAILCHIMP_WEBHOOK_SECRET=
